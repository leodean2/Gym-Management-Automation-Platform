# Server
PORT=4000
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?schema=public&sslmode=require"

# Auth (Feature 1 / NFR-S2)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
BCRYPT_COST_FACTOR=12

# Account lockout (FR-1.2)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password reset (FR-1.4)
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Rate limiting (NFR-S3)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
INQUIRY_RATE_LIMIT_MAX_REQUESTS=5

# Membership payment window (FR-11.5)
MEMBERSHIP_PAYMENT_WINDOW_HOURS=48

# Cloudinary (profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email notifications, Feature 13)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="no-reply@gymrocksfitness.com"

# CORS
CLIENT_ORIGIN="http://localhost:5173"
