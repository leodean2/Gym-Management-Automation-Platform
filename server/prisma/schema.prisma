generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Domain 1 — Identity & Security
// =====================================================

enum UserRole {
  Member
  Trainer
  Receptionist
  GymOwner
  SuperAdmin
}

enum AccountStatus {
  Active
  Inactive
}

enum Gender {
  Male
  Female
  Other
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  password_hash        String
  role                 UserRole
  account_status       AccountStatus @default(Active)
  failed_login_count   Int           @default(0)
  lockout_until        DateTime?
  must_change_password Boolean       @default(true)
  password_changed_at  DateTime?
  created_at           DateTime      @default(now())

  // Identity
  member  Member?  @relation("MemberUser")
  trainer Trainer? @relation("TrainerUser")

  member_created  Member[]  @relation("MemberCreatedBy")
  trainer_created Trainer[] @relation("TrainerCreatedBy")

  // Authentication
  password_reset_tokens PasswordResetToken[]

  // Membership
  membership_plans_created MembershipPlan[]    @relation("MembershipPlanCreatedBy")
  membership_plans_updated MembershipPlan[]    @relation("MembershipPlanUpdatedBy")
  memberships_created      Membership[]        @relation("MembershipCreatedBy")
  memberships_updated      Membership[]        @relation("MembershipUpdatedBy")
  membership_history       MembershipHistory[]

  // Financial
  invoices_issued               Invoice[]            @relation("InvoiceIssuedBy")
  payment_transactions_recorded PaymentTransaction[] @relation("PaymentRecordedBy")

  // Attendance
  attendances_created Attendance[] @relation("AttendanceCreatedBy")

  // Progress
  body_measurements_recorded BodyMeasurement[] @relation("BodyMeasurementRecordedBy")

  // Workout Programs
  trainer_assignments_reassigned TrainerAssignmentHistory[] @relation("TrainerAssignmentReassignedBy")

  // Workout Logging
  workout_sessions_finalized WorkoutSession[]              @relation("WorkoutSessionFinalizedBy")
  workout_sessions_reopened  WorkoutSessionReopenHistory[] @relation("WorkoutSessionReopenedBy")

  // Exercise Library
  exercise_library_entries_created ExerciseLibraryEntry[] @relation("ExerciseLibraryCreatedBy")

  // Booking
  bookings_created     Booking[]                  @relation("BookingCreatedBy")
  bookings_rescheduled BookingRescheduleHistory[] @relation("BookingRescheduledBy")
  bookings_reopened    BookingReopenHistory[]     @relation("BookingReopenedBy")

  // Contact & Inquiry
  inquiry_follow_up_notes_created InquiryFollowUpNote[] @relation("InquiryFollowUpCreatedBy")

  // Notifications
  notifications_received Notification[] @relation("NotificationRecipient")

  // Audit
  audit_logs AuditLog[] @relation("AuditLogUser")

  @@map("users")
}

model Member {
  id       String @id @default(uuid()) @db.Uuid
  user_id  String @unique @db.Uuid
  user     User   @relation("MemberUser", fields: [user_id], references: [id], onDelete: Restrict)

  created_by      String @db.Uuid
  created_by_user User   @relation("MemberCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  membership_number       String   @unique
  first_name               String
  last_name                String
  gender                    Gender
  date_of_birth             DateTime @db.Date
  phone_number              String
  address                   String?
  emergency_contact_name    String
  emergency_contact_phone   String
  medical_notes             String?
  profile_photo_url         String?

  current_trainer_id String?  @db.Uuid
  current_trainer    Trainer? @relation("CurrentTrainer", fields: [current_trainer_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships                 Membership[]
  membership_history          MembershipHistory[]
  attendances                 Attendance[]
  workout_program_assignments WorkoutProgramAssignment[]
  nutrition_plan_assignments  NutritionPlanAssignment[]
  workout_sessions            WorkoutSession[]
  body_measurements           BodyMeasurement[]
  personal_records            PersonalRecord[]
  bookings                    Booking[]
  linked_inquiries            Inquiry[]

  @@index([current_trainer_id])
  @@index([created_by])
  @@map("members")
}

model Trainer {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  user    User   @relation("TrainerUser", fields: [user_id], references: [id], onDelete: Restrict)

  created_by      String @db.Uuid
  created_by_user User   @relation("TrainerCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  employee_number   String   @unique
  first_name        String
  last_name         String
  phone_number      String
  specialization    String
  hire_date         DateTime @db.Date
  profile_photo_url String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  current_members              Member[]                   @relation("CurrentTrainer")
  templates_created             WorkoutProgramTemplate[]   @relation("WorkoutProgramTemplateCreatedBy")
  workout_program_assignments   WorkoutProgramAssignment[]
  nutrition_templates_created   NutritionPlanTemplate[]    @relation("NutritionPlanTemplateCreatedBy")
  nutrition_plan_assignments    NutritionPlanAssignment[]
  previous_assignments          TrainerAssignmentHistory[] @relation("PreviousTrainer")
  new_assignments                TrainerAssignmentHistory[] @relation("NewTrainer")
  availabilities TrainerAvailability[]
  bookings       Booking[]

  @@index([created_by])
  @@map("trainers")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// =====================================================
// Domain 2 — Membership
// =====================================================

enum MembershipPlanStatus {
  Active
  Inactive
}

enum MembershipStatus {
  Pending
  Active
  Expired
  Suspended
  Cancelled
}

enum MembershipHistoryEventType {
  InitialActivation
  Renewal
}

model MembershipPlan {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @unique
  description   String?
  duration_days Int
  price         Decimal              @db.Decimal(10, 2)
  status        MembershipPlanStatus @default(Active)

  created_by String @db.Uuid
  updated_by String? @db.Uuid

  created_by_user User  @relation("MembershipPlanCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  updated_by_user User? @relation("MembershipPlanUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships Membership[]
  history     MembershipHistory[]

  @@index([created_by])
  @@index([updated_by])
  @@map("membership_plans")
}

model Membership {
  id                 String            @id @default(uuid()) @db.Uuid
  member_id          String            @db.Uuid
  membership_plan_id String            @db.Uuid
  start_date         DateTime?         @db.Date
  expiry_date        DateTime?         @db.Date
  status             MembershipStatus  @default(Pending)
  suspended_reason   String?

  created_by String  @db.Uuid
  updated_by String? @db.Uuid

  member          Member         @relation(fields: [member_id], references: [id], onDelete: Restrict)
  membership_plan MembershipPlan @relation(fields: [membership_plan_id], references: [id], onDelete: Restrict)
  created_by_user User           @relation("MembershipCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  updated_by_user User?          @relation("MembershipUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  history  MembershipHistory[]
  invoices Invoice[]

  @@index([member_id])
  @@index([membership_plan_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("memberships")

  // NOTE: PostgreSQL partial unique index enforcing "one Active
  // membership per member" (FR-3.11) must be added manually in the
  // SQL migration. Prisma schema syntax does not support partial
  // unique indexes.
  //   CREATE UNIQUE INDEX memberships_one_active_per_member
  //   ON memberships (member_id) WHERE status = 'Active';
}

model MembershipHistory {
  id                  String                     @id @default(uuid()) @db.Uuid
  membership_id       String                     @db.Uuid
  member_id           String                     @db.Uuid
  membership_plan_id  String                     @db.Uuid
  invoice_id          String?                    @db.Uuid
  event_type          MembershipHistoryEventType
  period_start_date   DateTime                   @db.Date
  period_expiry_date  DateTime                   @db.Date
  recorded_by         String                     @db.Uuid
  recorded_at         DateTime                   @default(now())

  membership       Membership      @relation(fields: [membership_id], references: [id], onDelete: Restrict)
  member           Member          @relation(fields: [member_id], references: [id], onDelete: Restrict)
  membership_plan  MembershipPlan  @relation(fields: [membership_plan_id], references: [id], onDelete: Restrict)
  invoice          Invoice?        @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  recorded_by_user User            @relation(fields: [recorded_by], references: [id], onDelete: Restrict)

  @@index([membership_id])
  @@index([member_id])
  @@index([membership_plan_id])
  @@index([invoice_id])
  @@index([recorded_by])
  @@map("membership_history")
}

// =====================================================
// Domain 3 — Financial
// =====================================================

enum InvoiceStatus {
  Pending
  Paid
  Overdue
  Voided
  Cancelled
}

enum PaymentTransactionStatus {
  Successful
  Voided
}

enum ReceiptStatus {
  Issued
  Voided
}

enum PaymentMethod {
  Cash
  MPesa
  Card
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  membership_id       String        @db.Uuid
  invoice_number      String        @unique
  amount_due          Decimal       @db.Decimal(10, 2)
  due_date            DateTime
  status              InvoiceStatus @default(Pending)
  void_reason         String?
  issued_by           String        @db.Uuid
  replaces_invoice_id String?       @db.Uuid
  created_at          DateTime      @default(now())

  membership           Membership          @relation(fields: [membership_id], references: [id], onDelete: Restrict)
  issued_by_user       User                @relation("InvoiceIssuedBy", fields: [issued_by], references: [id], onDelete: Restrict)
  replaces_invoice     Invoice?            @relation("InvoiceCorrection", fields: [replaces_invoice_id], references: [id], onDelete: Restrict)
  replacement_invoices Invoice[]           @relation("InvoiceCorrection")
  payment_transaction  PaymentTransaction?
  membership_history   MembershipHistory[]

  @@index([membership_id])
  @@index([issued_by])
  @@index([replaces_invoice_id])
  @@map("invoices")
}

model PaymentTransaction {
  id                    String                    @id @default(uuid()) @db.Uuid
  invoice_id            String                    @unique @db.Uuid
  amount_paid           Decimal                   @db.Decimal(10, 2)
  payment_method        PaymentMethod
  transaction_reference String?
  status                PaymentTransactionStatus  @default(Successful)
  recorded_by           String                    @db.Uuid
  replaces_payment_id   String?                   @db.Uuid
  void_reason           String?
  payment_date          DateTime
  created_at            DateTime                  @default(now())

  invoice              Invoice              @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  recorded_by_user     User                 @relation("PaymentRecordedBy", fields: [recorded_by], references: [id], onDelete: Restrict)
  replaces_payment     PaymentTransaction?  @relation("PaymentCorrection", fields: [replaces_payment_id], references: [id], onDelete: Restrict)
  replacement_payments PaymentTransaction[] @relation("PaymentCorrection")
  receipt              Receipt?

  @@index([recorded_by])
  @@index([replaces_payment_id])
  @@map("payment_transactions")
}

model Receipt {
  id                      String        @id @default(uuid()) @db.Uuid
  payment_transaction_id  String        @unique @db.Uuid
  receipt_number          String        @unique
  status                  ReceiptStatus @default(Issued)
  replaces_receipt_id     String?       @db.Uuid
  void_reason             String?
  issued_at               DateTime
  created_at               DateTime     @default(now())

  payment_transaction  PaymentTransaction @relation(fields: [payment_transaction_id], references: [id], onDelete: Restrict)
  replaces_receipt     Receipt?           @relation("ReceiptCorrection", fields: [replaces_receipt_id], references: [id], onDelete: Restrict)
  replacement_receipts Receipt[]          @relation("ReceiptCorrection")

  @@index([replaces_receipt_id])
  @@map("receipts")
}

// =====================================================
// Domain 4 — Attendance
// =====================================================

enum AttendanceStatus {
  Present
  Voided
}

model Attendance {
  id                      String           @id @default(uuid()) @db.Uuid
  member_id                String          @db.Uuid
  membership_id             String          @db.Uuid
  attendance_date           DateTime        @db.Date
  check_in_time              DateTime
  status                     AttendanceStatus @default(Present)
  created_by                 String          @db.Uuid
  replaces_attendance_id     String?         @db.Uuid
  correction_reason          String?
  created_at                 DateTime        @default(now())

  member                 Member       @relation(fields: [member_id], references: [id], onDelete: Restrict)
  membership              Membership   @relation(fields: [membership_id], references: [id], onDelete: Restrict)
  created_by_user          User         @relation("AttendanceCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  replaces_attendance      Attendance?  @relation("AttendanceCorrection", fields: [replaces_attendance_id], references: [id], onDelete: Restrict)
  replacement_attendance   Attendance[] @relation("AttendanceCorrection")

  @@index([member_id])
  @@index([membership_id])
  @@index([created_by])
  @@index([replaces_attendance_id])
  @@map("attendance")
}

// =====================================================
// Domain 5 — Workout Programs (Prescribed)
// =====================================================

enum WorkoutProgramCategory {
  Strength
  Hypertrophy
  Cardio
  Rehabilitation
}

enum DifficultyLevel {
  Beginner
  Intermediate
  Advanced
}

enum WorkoutProgramTemplateStatus {
  Active
  Inactive
}

enum WorkoutProgramAssignmentStatus {
  Active
  Completed
  Replaced
}

model WorkoutProgramTemplate {
  id                       String                       @id @default(uuid()) @db.Uuid
  name                     String
  description              String?
  category                 WorkoutProgramCategory
  difficulty_level         DifficultyLevel
  estimated_duration_weeks Int
  created_by               String                       @db.Uuid
  status                   WorkoutProgramTemplateStatus @default(Active)
  created_at               DateTime                     @default(now())
  updated_at               DateTime                     @updatedAt

  created_by_trainer Trainer @relation("WorkoutProgramTemplateCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  sessions    WorkoutProgramSession[]
  assignments WorkoutProgramAssignment[]

  @@index([created_by])
  @@map("workout_program_templates")
}

model WorkoutProgramSession {
  id                           String   @id @default(uuid()) @db.Uuid
  workout_program_template_id  String   @db.Uuid
  session_name                 String
  description                  String?
  session_order                Int
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  template WorkoutProgramTemplate @relation(fields: [workout_program_template_id], references: [id], onDelete: Restrict)

  exercises        TemplateExercise[]
  workout_sessions WorkoutSession[]

  @@unique([workout_program_template_id, session_order])
  @@index([workout_program_template_id])
  @@map("workout_program_sessions")
}

model TemplateExercise {
  id                          String   @id @default(uuid()) @db.Uuid
  workout_program_session_id  String   @db.Uuid
  exercise_library_entry_id   String   @db.Uuid
  exercise_order               Int
  target_sets                  Int
  target_reps                  String
  target_weight                Decimal? @db.Decimal(6, 2)
  rest_seconds                 Int?
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  workout_program_session WorkoutProgramSession @relation(fields: [workout_program_session_id], references: [id], onDelete: Restrict)
  exercise                 ExerciseLibraryEntry  @relation(fields: [exercise_library_entry_id], references: [id], onDelete: Restrict)

  workout_exercises WorkoutExercise[]

  @@unique([workout_program_session_id, exercise_order])
  @@index([workout_program_session_id])
  @@index([exercise_library_entry_id])
  @@map("template_exercises")
}

model WorkoutProgramAssignment {
  id                           String                          @id @default(uuid()) @db.Uuid
  member_id                    String                          @db.Uuid
  trainer_id                   String                          @db.Uuid
  workout_program_template_id  String                          @db.Uuid
  start_date                   DateTime?                       @db.Date
  assigned_date                 DateTime                       @db.Date
  completion_date               DateTime?                      @db.Date
  assignment_notes              String?
  status                        WorkoutProgramAssignmentStatus @default(Active)
  created_at                    DateTime                       @default(now())
  updated_at                    DateTime                       @updatedAt

  member  Member                 @relation(fields: [member_id], references: [id], onDelete: Restrict)
  trainer Trainer                @relation(fields: [trainer_id], references: [id], onDelete: Restrict)
  template WorkoutProgramTemplate @relation(fields: [workout_program_template_id], references: [id], onDelete: Restrict)

  workout_sessions WorkoutSession[]

  @@index([member_id])
  @@index([trainer_id])
  @@index([workout_program_template_id])
  @@map("workout_program_assignments")
}

model TrainerAssignmentHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  member_id             String  @db.Uuid
  previous_trainer_id   String? @db.Uuid
  new_trainer_id        String  @db.Uuid
  reassigned_by         String  @db.Uuid
  reassigned_at          DateTime
  reason                 String?
  created_at              DateTime @default(now())

  member              Member  @relation(fields: [member_id], references: [id], onDelete: Restrict)
  previous_trainer    Trainer? @relation("PreviousTrainer", fields: [previous_trainer_id], references: [id], onDelete: SetNull)
  new_trainer          Trainer @relation("NewTrainer", fields: [new_trainer_id], references: [id], onDelete: Restrict)
  reassigned_by_user   User    @relation("TrainerAssignmentReassignedBy", fields: [reassigned_by], references: [id], onDelete: Restrict)

  @@index([member_id])
  @@index([previous_trainer_id])
  @@index([new_trainer_id])
  @@index([reassigned_by])
  @@map("trainer_assignment_history")
}

// =====================================================
// Domain 6 — Nutrition
// =====================================================

enum NutritionGoal {
  WeightLoss
  MuscleGain
  Maintenance
  Rehabilitation
}

enum NutritionPlanTemplateStatus {
  Active
  Inactive
}

enum NutritionPlanAssignmentStatus {
  Active
  Completed
  Replaced
}

model NutritionPlanTemplate {
  id                   String                       @id @default(uuid()) @db.Uuid
  created_by           String                       @db.Uuid
  name                 String
  goal                 NutritionGoal
  meal_guidelines      String
  daily_calorie_target Int?
  protein_grams        Int?
  carbohydrates_grams  Int?
  fats_grams           Int?
  status               NutritionPlanTemplateStatus  @default(Active)
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt

  created_by_trainer Trainer @relation("NutritionPlanTemplateCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  assignments NutritionPlanAssignment[]

  @@index([created_by])
  @@map("nutrition_plan_templates")
}

model NutritionPlanAssignment {
  id                          String                         @id @default(uuid()) @db.Uuid
  member_id                    String                        @db.Uuid
  trainer_id                   String                        @db.Uuid
  nutrition_plan_template_id   String                        @db.Uuid
  assigned_date                 DateTime                     @db.Date
  start_date                    DateTime?                    @db.Date
  completion_date               DateTime?                    @db.Date
  status                        NutritionPlanAssignmentStatus @default(Active)
  assignment_notes              String?
  created_at                    DateTime                     @default(now())
  updated_at                    DateTime                     @updatedAt

  member   Member                 @relation(fields: [member_id], references: [id], onDelete: Restrict)
  trainer  Trainer                @relation(fields: [trainer_id], references: [id], onDelete: Restrict)
  template NutritionPlanTemplate  @relation(fields: [nutrition_plan_template_id], references: [id], onDelete: Restrict)

  @@index([member_id])
  @@index([trainer_id])
  @@index([nutrition_plan_template_id])
  @@map("nutrition_plan_assignments")
}

// =====================================================
// Domain 7 — Workout Logging (Performed)
// =====================================================

enum WorkoutSessionStatus {
  InProgress
  Finalized
}

model WorkoutSession {
  id                              String               @id @default(uuid()) @db.Uuid
  member_id                       String               @db.Uuid
  workout_program_assignment_id   String               @db.Uuid
  workout_program_session_id      String               @db.Uuid
  session_date                    DateTime             @db.Date
  started_at                      DateTime?
  completed_at                    DateTime?
  status                          WorkoutSessionStatus @default(InProgress)
  finalized_by                    String?              @db.Uuid
  notes                           String?
  created_at                      DateTime             @default(now())
  updated_at                      DateTime             @updatedAt

  member                     Member                    @relation(fields: [member_id], references: [id], onDelete: Restrict)
  workout_program_assignment WorkoutProgramAssignment  @relation(fields: [workout_program_assignment_id], references: [id], onDelete: Restrict)
  workout_program_session    WorkoutProgramSession     @relation(fields: [workout_program_session_id], references: [id], onDelete: Restrict)
  finalized_by_user          User?                     @relation("WorkoutSessionFinalizedBy", fields: [finalized_by], references: [id], onDelete: SetNull)

  exercises      WorkoutExercise[]
  reopen_history WorkoutSessionReopenHistory[]

  @@index([member_id])
  @@index([workout_program_assignment_id])
  @@index([workout_program_session_id])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id                          String   @id @default(uuid()) @db.Uuid
  workout_session_id          String   @db.Uuid
  template_exercise_id        String?  @db.Uuid
  exercise_library_entry_id   String   @db.Uuid
  performed_sets               Int?
  performed_reps               Int?
  performed_weight             Decimal? @db.Decimal(6, 2)
  rest_seconds                 Int?
  duration_seconds             Int?
  distance                     Decimal? @db.Decimal(8, 2)
  perceived_exertion           Int?
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  workout_session   WorkoutSession    @relation(fields: [workout_session_id], references: [id], onDelete: Restrict)
  template_exercise TemplateExercise? @relation(fields: [template_exercise_id], references: [id], onDelete: SetNull)
  exercise          ExerciseLibraryEntry @relation(fields: [exercise_library_entry_id], references: [id], onDelete: Restrict)

  personal_records PersonalRecord[]

  @@index([workout_session_id])
  @@index([template_exercise_id])
  @@index([exercise_library_entry_id])
  @@map("workout_exercises")
}

model WorkoutSessionReopenHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  workout_session_id  String   @db.Uuid
  reopened_by         String   @db.Uuid
  reopened_at         DateTime
  reason              String
  created_at          DateTime @default(now())

  workout_session  WorkoutSession @relation(fields: [workout_session_id], references: [id], onDelete: Restrict)
  reopened_by_user User           @relation("WorkoutSessionReopenedBy", fields: [reopened_by], references: [id], onDelete: Restrict)

  @@index([workout_session_id])
  @@index([reopened_by])
  @@map("workout_session_reopen_history")
}

// =====================================================
// Domain 8 — Progress Tracking
// =====================================================

model BodyMeasurement {
  id                String   @id @default(uuid()) @db.Uuid
  member_id          String  @db.Uuid
  recorded_by         String @db.Uuid
  measurement_date     DateTime @db.Date
  weight_kg            Decimal? @db.Decimal(5, 2)
  body_fat_percentage  Decimal? @db.Decimal(5, 2)
  chest_cm             Decimal? @db.Decimal(5, 2)
  waist_cm             Decimal? @db.Decimal(5, 2)
  hips_cm              Decimal? @db.Decimal(5, 2)
  left_arm_cm          Decimal? @db.Decimal(5, 2)
  right_arm_cm         Decimal? @db.Decimal(5, 2)
  left_thigh_cm        Decimal? @db.Decimal(5, 2)
  right_thigh_cm       Decimal? @db.Decimal(5, 2)
  notes                String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  member            Member @relation(fields: [member_id], references: [id], onDelete: Restrict)
  recorded_by_user  User   @relation("BodyMeasurementRecordedBy", fields: [recorded_by], references: [id], onDelete: Restrict)

  @@index([member_id])
  @@index([recorded_by])
  @@index([measurement_date])
  @@map("body_measurements")
}

model PersonalRecord {
  id                          String   @id @default(uuid()) @db.Uuid
  member_id                    String  @db.Uuid
  exercise_library_entry_id    String  @db.Uuid
  workout_exercise_id          String  @db.Uuid
  best_weight                   Decimal @db.Decimal(6, 2)
  achieved_at                    DateTime
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  member           Member               @relation(fields: [member_id], references: [id], onDelete: Restrict)
  exercise         ExerciseLibraryEntry @relation(fields: [exercise_library_entry_id], references: [id], onDelete: Restrict)
  workout_exercise WorkoutExercise      @relation(fields: [workout_exercise_id], references: [id], onDelete: Restrict)

  @@unique([member_id, exercise_library_entry_id])
  @@index([member_id])
  @@index([exercise_library_entry_id])
  @@index([workout_exercise_id])
  @@map("personal_records")
}

// =====================================================
// Domain 9 — Exercise Library
// =====================================================

enum ExerciseCategory {
  Strength
  Cardio
  Flexibility
  Mobility
  Rehabilitation
}

enum ExerciseType {
  Weighted
  Bodyweight
  Cardio
}

enum ExerciseLibraryStatus {
  Active
  Inactive
}

model ExerciseLibraryEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String                 @unique
  category       ExerciseCategory
  exercise_type  ExerciseType
  muscle_group   String
  description    String?
  status         ExerciseLibraryStatus  @default(Active)
  created_by     String                 @db.Uuid
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  created_by_user User @relation("ExerciseLibraryCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  template_exercises TemplateExercise[]
  workout_exercises  WorkoutExercise[]
  personal_records   PersonalRecord[]

  @@index([created_by])
  @@map("exercise_library_entries")
}

// =====================================================
// Domain 10 — Booking & Scheduling
// =====================================================

enum TrainerAvailabilityStatus {
  Available
  Unavailable
}

enum BookingStatus {
  Scheduled
  Completed
  Cancelled
  NoShow
}

enum BookingPreviousStatus {
  Completed
  Cancelled
  NoShow
}

model TrainerAvailability {
  id                String                    @id @default(uuid()) @db.Uuid
  trainer_id         String                    @db.Uuid
  availability_date   DateTime                  @db.Date
  start_time           DateTime                  @db.Time(6)
  end_time             DateTime                  @db.Time(6)
  status               TrainerAvailabilityStatus @default(Available)
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt

  trainer  Trainer   @relation(fields: [trainer_id], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([trainer_id])
  @@index([availability_date])
  @@map("trainer_availability")
}

model Booking {
  id                        String        @id @default(uuid()) @db.Uuid
  member_id                  String       @db.Uuid
  trainer_id                  String       @db.Uuid
  trainer_availability_id      String       @db.Uuid
  booking_date                  DateTime     @db.Date
  start_time                     DateTime     @db.Time(6)
  end_time                       DateTime     @db.Time(6)
  status                          BookingStatus @default(Scheduled)
  cancellation_reason             String?
  notes                           String?
  created_by                      String       @db.Uuid
  created_at                       DateTime     @default(now())
  updated_at                       DateTime     @updatedAt

  member                 Member              @relation(fields: [member_id], references: [id], onDelete: Restrict)
  trainer                 Trainer             @relation(fields: [trainer_id], references: [id], onDelete: Restrict)
  trainer_availability      TrainerAvailability @relation(fields: [trainer_availability_id], references: [id], onDelete: Restrict)
  created_by_user            User                @relation("BookingCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  reschedule_history BookingRescheduleHistory[]
  reopen_history      BookingReopenHistory[]

  @@index([member_id])
  @@index([trainer_id])
  @@index([trainer_availability_id])
  @@index([booking_date])
  @@map("bookings")

  // NOTE: PostgreSQL exclusion constraint preventing overlapping
  // Scheduled bookings per trainer (FR-10.4) must be added manually
  // in the SQL migration. Prisma schema syntax does not support
  // exclusion constraints.
  //   ALTER TABLE bookings ADD CONSTRAINT bookings_no_overlap
  //   EXCLUDE USING gist (
  //     trainer_id WITH =,
  //     tsrange(booking_date + start_time, booking_date + end_time) WITH &&
  //   ) WHERE (status = 'Scheduled');
}

model BookingRescheduleHistory {
  id                      String   @id @default(uuid()) @db.Uuid
  booking_id               String  @db.Uuid
  previous_booking_date     DateTime @db.Date
  previous_start_time       DateTime @db.Time(6)
  previous_end_time         DateTime @db.Time(6)
  new_booking_date           DateTime @db.Date
  new_start_time              DateTime @db.Time(6)
  new_end_time                 DateTime @db.Time(6)
  rescheduled_by                String  @db.Uuid
  rescheduled_at                 DateTime
  reason                          String

  booking              Booking @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  rescheduled_by_user  User    @relation("BookingRescheduledBy", fields: [rescheduled_by], references: [id], onDelete: Restrict)

  @@index([booking_id])
  @@index([rescheduled_by])
  @@map("booking_reschedule_history")
}

model BookingReopenHistory {
  id                String                 @id @default(uuid()) @db.Uuid
  booking_id         String                @db.Uuid
  previous_status     BookingPreviousStatus
  reopened_by          String                @db.Uuid
  reopened_at            DateTime
  reason                  String

  booking           Booking @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  reopened_by_user  User    @relation("BookingReopenedBy", fields: [reopened_by], references: [id], onDelete: Restrict)

  @@index([booking_id])
  @@index([reopened_by])
  @@map("booking_reopen_history")
}

// =====================================================
// Domain 11 — Notifications
// =====================================================

enum NotificationType {
  PasswordReset
  PasswordChanged
  StaffAccountIssued
  MemberWelcome
  MembershipActivated
  MembershipRenewed
  MembershipExpiryReminder
  MembershipExpired
  PaymentConfirmation
  ReceiptGenerated
  BookingConfirmation
  BookingReminder
  BookingCancelled
  BookingRescheduled
  InquirySubmitted
}

enum NotificationChannel {
  Email
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum RelatedEntityType {
  User
  Member
  Trainer
  Membership
  MembershipHistory
  Invoice
  PaymentTransaction
  Receipt
  Booking
  Inquiry
}

enum NotificationAttemptStatus {
  Queued
  Sent
  Failed
}

model Notification {
  id                    String              @id @default(uuid()) @db.Uuid
  notification_type      NotificationType
  recipient_user_id        String?           @db.Uuid
  recipient_email            String
  channel                     NotificationChannel @default(Email)
  related_entity_type          RelatedEntityType
  related_entity_id              String            @db.Uuid
  status                          NotificationStatus @default(Pending)
  sent_at                          DateTime?
  created_at                        DateTime          @default(now())

  recipient_user User? @relation("NotificationRecipient", fields: [recipient_user_id], references: [id], onDelete: SetNull)

  attempts NotificationAttempt[]

  @@index([recipient_user_id])
  @@index([notification_type])
  @@index([status])
  @@map("notifications")
}

model NotificationAttempt {
  id                    String                    @id @default(uuid()) @db.Uuid
  notification_id        String                    @db.Uuid
  attempt_number           Int
  status                     NotificationAttemptStatus
  attempted_at                 DateTime
  provider_message_id            String?
  failure_reason                  String?
  created_at                        DateTime                  @default(now())

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Restrict)

  @@unique([notification_id, attempt_number])
  @@index([notification_id])
  @@map("notification_attempts")
}

// =====================================================
// Domain 12 — Contact & Inquiry
// =====================================================

enum InquiryStatus {
  New
  Contacted
  Closed
}

enum InquiryOutcome {
  Joined
  NotInterested
}

model Inquiry {
  id                 String          @id @default(uuid()) @db.Uuid
  full_name           String
  email                 String
  phone_number            String
  subject                   String?
  message                     String
  status                       InquiryStatus   @default(New)
  outcome                        InquiryOutcome?
  linked_member_id                  String?         @db.Uuid
  created_at                          DateTime        @default(now())
  updated_at                            DateTime        @updatedAt

  linked_member    Member?               @relation(fields: [linked_member_id], references: [id], onDelete: SetNull)
  follow_up_notes  InquiryFollowUpNote[]

  @@index([status])
  @@index([linked_member_id])
  @@map("inquiries")
}

/// NOTE:
/// Inquiry records may be created from unauthenticated public requests.
/// This is enforced by the API layer, not the database schema.
/// Therefore Inquiry intentionally has no created_by field.

model InquiryFollowUpNote {
  id           String   @id @default(uuid()) @db.Uuid
  inquiry_id     String  @db.Uuid
  created_by       String  @db.Uuid
  note                String
  created_at            DateTime @default(now())

  inquiry           Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Restrict)
  created_by_user   User    @relation("InquiryFollowUpCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([inquiry_id])
  @@index([created_by])
  @@map("inquiry_follow_up_notes")
}

// =====================================================
// Domain 13 — Audit & Security
// =====================================================

enum AuditEventType {
  LoginSucceeded
  LoginFailed
  AccountLocked
  PasswordResetRequested
  PasswordResetCompleted
  PasswordChanged
  UnauthorizedAccessAttempt
  AccountStatusBlocked
  CsvExportGenerated
  NotificationManualResend
}

enum AuditOutcome {
  Success
  Failure
}

enum AuditRelatedEntityType {
  User
  Member
  Trainer
  Membership
  Invoice
  PaymentTransaction
  Receipt
  WorkoutProgramTemplate
  NutritionPlanTemplate
  WorkoutSession
  Booking
  Inquiry
  Notification
}

model AuditLog {
  id                    String                   @id @default(uuid()) @db.Uuid
  user_id                 String?                @db.Uuid
  event_type                AuditEventType
  action                       String
  outcome                         AuditOutcome
  related_entity_type                AuditRelatedEntityType?
  related_entity_id                     String?               @db.Uuid
  ip_address                               Unsupported("inet")?
  user_agent                                  String?
  details                                        Json?
  occurred_at                                       DateTime
  created_at                                           DateTime              @default(now())

  user User? @relation("AuditLogUser", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([event_type])
  @@index([occurred_at])
  @@index([related_entity_type, related_entity_id])
  @@map("audit_logs")
}

// Append-only table.
// Records are never updated or deleted.
// Infrastructure/system errors are intentionally excluded;
// they belong to operational logging rather than application audit history.
